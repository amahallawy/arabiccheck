{
  "name": "@arabiccheck/checker-en",
  "version": "0.0.0",
  "private": true,
  "description": "English spelling and real-word checker for ArabicCheck: an adapter over tinyfix 0.1.1.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@arabiccheck/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.src.json && tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@arabiccheck/core": "0.0.0",
    "tinyfix": "0.1.1"
  }
}
