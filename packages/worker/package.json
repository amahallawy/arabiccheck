{
  "name": "@arabiccheck/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Runs ArabicCheck's English and Arabic checkers in one module Web Worker, with a page-side client that drops stale replies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/worker.ts",
    "./dist/worker.js"
  ],
  "exports": {
    ".": {
      "@arabiccheck/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "@arabiccheck/source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.src.json && tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@arabiccheck/checker-ar": "0.0.0",
    "@arabiccheck/checker-en": "0.0.0",
    "@arabiccheck/core": "0.0.0"
  }
}
